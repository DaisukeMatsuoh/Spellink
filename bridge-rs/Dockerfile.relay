# The relay as a single static binary in an empty container (ADR 0018):
#   docker build -f bridge-rs/Dockerfile.relay -t spellink-relay bridge-rs
#   docker run --rm -p 8780:8780 spellink-relay        # behind Cloudflare/a proxy: add --trust-proxy
FROM rust:1 AS build
ARG TARGET=x86_64-unknown-linux-musl
RUN rustup target add $TARGET
WORKDIR /src
COPY . .
RUN cargo build --release --locked --target $TARGET && cp target/$TARGET/release/spellink-bridge /spellink-bridge

FROM scratch
COPY --from=build /spellink-bridge /spellink-bridge
USER 65534:65534
EXPOSE 8780
ENTRYPOINT ["/spellink-bridge", "relay"]
