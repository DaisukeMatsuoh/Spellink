<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for macOS. Replace YOUR_USER, then:
       cp com.cloute.bridge.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.cloute.bridge.plist
     launchd starts with a minimal PATH, so the PATH below must include where `claude` lives. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cloute.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/.local/bin/cloute-bridge</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/YOUR_USER/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/cloute-bridge.log</string>
  <key>StandardErrorPath</key><string>/tmp/cloute-bridge.log</string>
</dict>
</plist>
