# systemd user service for the Spellink relay (ADR 0010). It listens only on localhost;
# put Cloudflare Tunnel (or another TLS reverse proxy) in front of it, e.g.
#   cloudflared tunnel route dns spellink-relay relay.<your-domain>
#   ingress: hostname relay.<your-domain> → service http://127.0.0.1:8780
# Install:
#   cp spellink-relay.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now spellink-relay
[Unit]
Description=Spellink relay (lets plugins reach bridges behind NAT)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/spellink-bridge relay -listen 127.0.0.1:8780
Restart=on-failure

[Install]
WantedBy=default.target
