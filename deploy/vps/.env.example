# Copy to .env (next to compose.yaml) on each server and edit. .env is not committed.
#
# The name this server's relay answers to (one relay per region):
#   Japan:  RELAY_NAME=jp.relay.spellink.uk
#   US:     RELAY_NAME=us.relay.spellink.uk
RELAY_NAME=jp.relay.spellink.uk
#
# Where the one name service is. On the server that runs it, this is itself.
NAMES_URL=https://names.spellink.uk:8443
#
# Only on the server that runs the name service: the IDs of the operator's relays, comma
# separated (each relay prints its own at its first start). They are not counted against the
# weekly allowance of new certificates, and are never refused (docs/spec/lan-cert.md L9).
INFRA_IDS=
