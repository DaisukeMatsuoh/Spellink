{
  "name": "Spellink",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build": "node scripts/prepare-local-config.js && bash buildPlugin.sh",
    "typecheck": "node scripts/prepare-local-config.js && tsc --noEmit",
    "test:coverage": "jest --coverage",
    "spec": "node scripts/gen-tables.js && prettier --write src/*.generated.ts && (cd ../bridge && $HOME/.local/go/bin/gofmt -w internal/server/runtable_gen.go)"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "sn-plugin-lib": "^0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "description": "Ask Claude about lassoed handwriting and get the answer written back as handwriting",
  "license": "Apache-2.0"
}
