{
  "name": "Spellink",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "build": "bash buildPlugin.sh",
    "typecheck": "tsc --noEmit",
    "test:coverage": "jest --coverage",
    "strings": "node scripts/gen-strings.js && prettier --write src/strings.generated.ts",
    "spec": "node scripts/gen-tables.js && prettier --write src/*.generated.ts && (cd ../bridge && $HOME/.cargo/bin/rustfmt --edition 2024 src/server/run_table.rs src/devices/table.rs src/lan/reg_table.rs src/lan/cert_table.rs)"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "qrcode-generator": "2.0.4",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "sn-plugin-lib": "^0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.1",
    "@react-native-community/cli-platform-android": "18.0.1",
    "@react-native-community/cli-platform-ios": "18.0.1",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "jsqr": "1.4.0",
    "prettier": "3.10.1",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4",
    "ws": "^8.23.0"
  },
  "engines": {
    "node": ">=18"
  },
  "description": "Ask Claude about lassoed handwriting and get the answer written back as handwriting",
  "license": "Apache-2.0"
}
